#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#
# Standard Gradle wrapper shell script. Requires gradle/wrapper/gradle-wrapper.jar
# to be present (see README.md — it is not bundled in this export because this
# environment has no network access to fetch it).
#

APP_HOME=$(cd "$(dirname "$0")" >/dev/null && pwd)
APP_NAME="Gradle"
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

JAVACMD="java"
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
fi

exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
